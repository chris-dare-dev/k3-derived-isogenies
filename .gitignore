*.jsonl
*.jsonl.gz
*.json
*.json.gz
*.part
*.log
# Release archive and checksums, built locally
dist/
# Python
__pycache__/
*.pyc
.venv/

# Data archive placed at the root for the notebooks
*.tar.xz
*.tar.xz.sha256
.ipynb_checkpoints/

# Scratch runs of the scheduler: records, reports and work directories (make run); caches of the lint tools
results/
.ruff_cache/
.mypy_cache/
# Kept in git, although the patterns above would ignore them: the records adopted from finished runs
!records/*/results.jsonl
!records/*/manifest.json
!records/*/adopted.json
